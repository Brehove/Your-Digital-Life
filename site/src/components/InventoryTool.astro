---
import { createCalculatorSourceMap, getCalculatorById, resolveCalculatorSources, type CalculatorActivity, type CalculatorPreset } from "../lib/calculators";

interface Props { calculatorId?: string; showEvidenceTable?: boolean; }
const { calculatorId = "digital-inventory", showEvidenceTable = true } = Astro.props as Props;
const calculator = await getCalculatorById(calculatorId);
if (!calculator) throw new Error(`Missing calculator content entry: ${calculatorId}`);

const sourceMap = createCalculatorSourceMap(calculator);
const activities: CalculatorActivity[] = calculator.data.activities;
const presets: CalculatorPreset[] = calculator.data.presets;
const devices = calculator.data.deviceProfiles;
const deviceMap = new Map(devices.map((device) => [device.id, device]));
const initialPreset = presets.find((preset) => preset.id === "gen-z-vibe-coder") ?? presets[0];
const groups = [
  { id: "ai", label: "AI tasks", icon: "sparkle" },
  { id: "media", label: "Media & entertainment", icon: "youtube" },
  { id: "gaming", label: "Gaming", icon: "game-controller" },
  { id: "work", label: "Work & communication", icon: "video-camera" }
] as const;
function displayGroup(activity: CalculatorActivity) {
  if (activity.id === "cloud-docs-browsing" || activity.category === "Meetings") return "work";
  if (activity.category === "Media and search") return "media";
  if (activity.category === "Gaming") return "gaming";
  return "ai";
}
const activityIcons: Record<string, string> = {
  "text-prompts": "sparkle", "reasoning-prompts": "brain", "image-generation": "image",
  "coding-agent-requests-intensive": "terminal", "vibe-coding": "terminal", tiktok: "tiktok", instagram: "instagram", snapchat: "snapchat",
  youtube: "youtube", netflix: "netflix", "cloud-docs-browsing": "globe",
  "gaming-console-xbox-series-x": "xbox", "zoom-participant": "video-camera", "zoom-host": "video-camera"
};
function baseUnit(activity: CalculatorActivity) {
  if (activity.unitLabel === "daily blocks") return "daily block";
  if (activity.id === "gaming-console-xbox-series-x") return "player-hour";
  if (activity.unitLabel === "hours") return "hour";
  return activity.unitLabel.endsWith("s") ? activity.unitLabel.slice(0, -1) : activity.unitLabel;
}
function displayBaseRate(activity: CalculatorActivity) {
  const prefix = activity.id === "coding-agent-requests-intensive" ? "~" : "";
  return `${prefix}${activity.totalWhPerUnit} Wh`;
}
function accessibleActivityLabel(activity: CalculatorActivity) {
  return `${activity.label}${activity.displayQualifier ? `, ${activity.displayQualifier}` : ""}`;
}
function activitySources(activity: CalculatorActivity) {
  return resolveCalculatorSources(activity.sourceIds, sourceMap, `calculator row "${activity.label}"`);
}
const payload = JSON.stringify({ activities, presets, devices }).replace(/</g, "\\u003c");
---

<article class="ydl-calculator" data-inventory-tool>
  <a class="ydl-skip" href="#ydl-activity-groups">Skip to calculator inputs</a>
  <div class="ydl-presets" role="group" aria-label="Starter mixes">
    <span>Start from</span>
    {presets.map((preset) => (
      <button type="button" class:list={["ydl-pill", { "is-selected": preset.id === initialPreset?.id }]}
        data-preset={preset.id} aria-pressed={preset.id === initialPreset?.id ? "true" : "false"}
        title={preset.description.replace("Section 3 scenario with ", "Example with ")}>
        {preset.label}
      </button>
    ))}
    <span class="ydl-custom" data-custom-label hidden>Custom day</span>
  </div>

  <p class="ydl-base-help" id="ydl-base-help">
    Base rates show <strong>broader-system energy per unit</strong>{" "}for the selected device.
    The image-generation rate is a GPU-only floor.{" "}
    <a href="/sources-and-method/">What these estimates include →</a>
  </p>

  <div class="ydl-calculator-grid">
    <div class="ydl-activity-groups" id="ydl-activity-groups">
      {groups.map((group) => {
        const items = activities.filter((activity) => displayGroup(activity) === group.id);
        return (
          <details class={`ydl-group ydl-group--${group.id}`} data-group={group.id} open>
            <summary>
              <span class="ydl-icon" data-icon={group.icon} aria-hidden="true"></span>
              <h2>{group.label}</h2>
              <span class="ydl-group-count" data-group-count={group.id}>0 active of {items.length}</span>
              <span class="ydl-icon ydl-caret" data-icon="caret-down" aria-hidden="true"></span>
            </summary>
            <div class="ydl-card-grid">
              {items.map((activity) => {
                const defaultDevice = activity.defaultDeviceId ? deviceMap.get(activity.defaultDeviceId) : undefined;
                const sources = activitySources(activity);
                return (
                  <article class="ydl-activity" data-activity={activity.id} data-group-id={group.id}>
                    <div class="ydl-activity-title">
                      <span class="ydl-icon" data-icon={activityIcons[activity.id]} aria-hidden="true"></span>
                      <div>
                        <h3>{activity.label}</h3>
                        {activity.displayQualifier && <p class="ydl-qualifier">{activity.displayQualifier}</p>}
                        <p id={`ydl-hint-${activity.id}`} class:list={{ "ydl-helper": Boolean(activity.displayQualifier) }}>{activity.unitHint}</p>
                      </div>
                    </div>
                    <div class="ydl-base">
                      <b>Base</b>
                      <span>1 {baseUnit(activity)} · <strong data-base-rate={activity.id}>{displayBaseRate(activity)}</strong>{" "}
                        {activity.id !== "coding-agent-requests-intensive" && <>per {baseUnit(activity)}</>}
                        {activity.id === "image-generation" ? " · GPU-only floor" : ""}</span>
                    </div>
                    <div class="ydl-controls">
                      <div class="ydl-stepper">
                        <button type="button" data-step-down={activity.id} aria-label={`Decrease ${activity.label}`}>−</button>
                        <input id={`ydl-${activity.id}`} type="number" min="0" step={activity.step} value="0"
                          inputmode={activity.unitLabel === "requests" ? "numeric" : "decimal"} data-activity-input={activity.id}
                          aria-label={accessibleActivityLabel(activity)}
                          aria-describedby={`ydl-unit-${activity.id} ydl-hint-${activity.id} ydl-base-help`} />
                        <button type="button" data-step-up={activity.id} aria-label={`Increase ${activity.label}`}>+</button>
                        <span id={`ydl-unit-${activity.id}`} data-unit-label={activity.id}>{activity.unitLabel}</span>
                      </div>
                      {activity.deviceMode === "selectable" && activity.deviceSelectableIds.length > 0 && (
                        <select aria-label={`${activity.label} device`} data-device-select={activity.id}>
                          {activity.deviceSelectableIds.map((id) => (
                            <option value={id} selected={id === activity.defaultDeviceId}>{deviceMap.get(id)?.label ?? id}</option>
                          ))}
                        </select>
                      )}
                    </div>
                    <p class="ydl-minutes" data-minutes={activity.id} hidden></p>
                    <div class="ydl-card-footer">
                      <span>{activity.deviceMode === "not-modeled" ? "End-user device not modeled"
                        : activity.deviceMode === "selectable" ? "Phone, laptop, or TV"
                        : `Device · ${defaultDevice?.label ?? "Fixed reference"} (fixed)`}</span>
                      <button type="button" class:list={["ydl-badge", `is-${activity.status}`]}
                        data-open-detail={activity.id}
                        aria-label={`${accessibleActivityLabel(activity)}: ${activity.status}. View sources and assumptions`}>
                        {activity.status}<span aria-hidden="true"> ↗</span>
                      </button>
                    </div>
                    <dialog class="ydl-dialog" data-detail-dialog={activity.id} aria-labelledby={`ydl-detail-title-${activity.id}`}>
                      <div class="ydl-dialog-head">
                        <h2 id={`ydl-detail-title-${activity.id}`}>{activity.label}</h2>
                        <button type="button" data-close-detail aria-label="Close sources and assumptions">Close ×</button>
                      </div>
                      <p class="ydl-detail-status">
                        {activity.status} · Base unit: 1 {baseUnit(activity)}
                        {activity.id === "coding-agent-requests-intensive" && <> · Broader-system reference: {displayBaseRate(activity)}</>}
                      </p>
                      <p>{activity.note}</p>
                      <dl class="ydl-detail-values">
                        <div><dt>Selected quantity</dt><dd data-detail-value="quantity">0 {activity.unitLabel}</dd></div>
                        <div><dt>Cloud/source-side energy</dt><dd data-detail-value="serverEnergy">0 Wh</dd></div>
                        <div><dt>Broader-system energy</dt><dd data-detail-value="totalEnergy">0 Wh</dd></div>
                        <div><dt>Direct water</dt><dd data-detail-value="directWater">0 mL</dd></div>
                        <div><dt>Total water</dt><dd data-detail-value="totalWater">0 mL</dd></div>
                      </dl>
                      {activity.deviceNote && <p class="ydl-boundary-note">{activity.deviceNote}</p>}
                      {activity.serverEnergyBoundary && <p class="ydl-boundary-note">{activity.serverEnergyBoundary}</p>}
                      {activity.totalEnergyBoundary && <p class="ydl-boundary-note">{activity.totalEnergyBoundary}</p>}
                      {activity.directWaterBoundary && <p class="ydl-boundary-note">{activity.directWaterBoundary}</p>}
                      {activity.totalWaterBoundary && <p class="ydl-boundary-note">{activity.totalWaterBoundary}</p>}
                      <h3>Sources</h3>
                      <ul class="ydl-source-links">{sources.map((source) => (
                        <li><a href={source.url} target="_blank" rel="noreferrer">{source.title}</a></li>
                      ))}</ul>
                      <a href="/sources-and-method/">Full sources & method →</a>
                    </dialog>
                  </article>
                );
              })}
            </div>
          </details>
        );
      })}
    </div>

    <aside class="ydl-results" aria-label="Current calculator totals">
      <div class="ydl-metrics">
        <section>
          <h2><span class="ydl-icon" data-icon="lightning" aria-hidden="true"></span>Energy</h2>
          <div class="ydl-measure"><span title="Server and network demand, with activity-specific boundaries">Cloud/source-side</span><strong data-summary="serverEnergy">0 <small>Wh</small></strong></div>
          <div class="ydl-measure"><span title="Includes the additional modeled system components for each activity">Broader-system</span><strong data-summary="totalEnergy">0 <small>Wh</small></strong></div>
          <p class="ydl-anchor">≈ <b data-summary="energyLaptop">0</b> laptop batteries<br /><span>(50 Wh each)</span></p>
        </section>
        <section>
          <h2><span class="ydl-icon" data-icon="drop" aria-hidden="true"></span>Water</h2>
          <div class="ydl-measure"><span>Direct</span><strong data-summary="directWater">0 <small>mL</small></strong></div>
          <div class="ydl-measure"><span>Total</span><strong data-summary="totalWater">0 <small>mL</small></strong></div>
          <p class="ydl-anchor">≈ <b data-summary="waterCups">0</b> cups<br /><span>(236.588 mL each)</span></p>
        </section>
      </div>
      <section class="ydl-drivers">
        <h2>What drives this day?</h2>
        <div class="ydl-toggle" role="group" aria-label="Contribution metric">
          <button type="button" class="is-active" data-driver-mode="totalEnergy" aria-pressed="true">Energy (Wh)</button>
          <button type="button" data-driver-mode="totalWater" aria-pressed="false">Water (mL)</button>
        </div>
        <p class="ydl-chart-note" data-driver-note>Contributions for the amounts selected, broader-system energy.</p>
        <ol class="ydl-chart" data-driver-list aria-label="Activities ranked by broader-system energy"></ol>
        <p class="ydl-empty" data-driver-empty hidden>Choose a starter mix or enter an activity to see what drives your day.</p>
        <div class="ydl-axis" data-driver-axis aria-hidden="true"></div>
        <div class="ydl-legend">{groups.map((group) => (
          <span data-group={group.id}><i></i>{group.label === "AI tasks" ? "AI" : group.label}</span>
        ))}</div>
      </section>
      <div class="ydl-chart-total">
        <span data-driver-total-label>Total broader-system energy</span>
        <strong data-driver-total>0 <small>Wh</small></strong>
      </div>
      <a class="ydl-method-link" href="/sources-and-method/">Understand the measures & sources →</a>
    </aside>
  </div>
  <div class="ydl-bottom-actions">
    <button type="button" data-clear-all>Clear all</button>
    <a href="/sources-and-method/">Sources & Method</a>
  </div>
  <p class="sr-only" aria-live="polite" data-live-summary>Current totals are 0 watt-hours broader-system energy and 0 milliliters total water.</p>
  {showEvidenceTable && (
    <section class="ydl-evidence-link" aria-label="Calculator evidence">
      <h2>Review the full calculator method</h2>
      <p>Every activity’s source, boundary, status, and calculation is documented on the method page.</p>
      <a href="/sources-and-method/">Open Sources & Method →</a>
    </section>
  )}
  <script is:inline type="application/json" data-inventory-data set:html={payload}></script>
</article>

<script is:inline>
  (() => {
    const dataNode = document.currentScript?.previousElementSibling?.querySelector("[data-inventory-data]");
    const root = dataNode?.closest("[data-inventory-tool]");
    if (!(root instanceof HTMLElement) || !(dataNode instanceof HTMLScriptElement) || root.dataset.ready) return;
    root.dataset.ready = "true";
    let data;
    try { data = JSON.parse(dataNode.textContent || "{}"); }
    catch (error) { console.error("Inventory tool payload parse failed.", error); return; }
    const activities = data.activities || [], presets = data.presets || [];
    const activityMap = new Map(activities.map((activity) => [activity.id, activity]));
    const inputs = Array.from(root.querySelectorAll("[data-activity-input]"));
    const selects = Array.from(root.querySelectorAll("[data-device-select]"));
    const presetButtons = Array.from(root.querySelectorAll("[data-preset]"));
    const formatter = new Intl.NumberFormat("en-US", { maximumFractionDigits: 2 });
    const cupFormatter = new Intl.NumberFormat("en-US", { maximumFractionDigits: 1 });
    const iconNames = {
      "text-prompts":"sparkle","reasoning-prompts":"brain","image-generation":"image","coding-agent-requests-intensive":"terminal","vibe-coding":"terminal",
      tiktok:"tiktok",instagram:"instagram",snapchat:"snapchat",youtube:"youtube",netflix:"netflix",
      "cloud-docs-browsing":"globe","gaming-console-xbox-series-x":"xbox","zoom-participant":"video-camera","zoom-host":"video-camera"
    };
    const shortLabels = {"text-prompts":"Text prompts","reasoning-prompts":"High-reasoning","image-generation":"Images",
      "coding-agent-requests-intensive":"Coding agent (intensive)","vibe-coding":"Coding agent","cloud-docs-browsing":"Browsing","gaming-console-xbox-series-x":"Gaming console",
      "zoom-participant":"Zoom participant","zoom-host":"Zoom host",tiktok:"TikTok",instagram:"Instagram",
      snapchat:"Snapchat",youtube:"YouTube",netflix:"Netflix"};
    const groupFor = (activity) => activity.id === "cloud-docs-browsing" || activity.category === "Meetings" ? "work"
      : activity.category === "Media and search" ? "media" : activity.category === "Gaming" ? "gaming" : "ai";
    let driverMode = "totalEnergy", computed = [];
    const format = (value) => formatter.format(value);
    const unitLabel = (activity, quantity) => quantity === 1
      ? (activity.unitLabel.endsWith("s") ? activity.unitLabel.slice(0, -1) : activity.unitLabel)
      : activity.unitLabel;
    const wholeRequests = (activity) => activity?.unitLabel === "requests";
    const metricHtml = (value, unit) => `${format(value)} <small>${unit}</small>`;
    const selectedDevice = (activity) => root.querySelector(`[data-device-select="${activity.id}"]`)?.value
      || activity.defaultDeviceId || activity.deviceSelectableIds?.[0] || null;
    const totalRate = (activity) => {
      const id = selectedDevice(activity);
      return id && activity.deviceSelectionAffects?.includes("totalWhPerUnit")
        ? activity.deviceTotalWhOverrides?.[id] ?? activity.totalWhPerUnit : activity.totalWhPerUnit;
    };
    function setPresetState(id) {
      presetButtons.forEach((button) => {
        const active = button.dataset.preset === id;
        button.classList.toggle("is-selected", active);
        button.setAttribute("aria-pressed", active ? "true" : "false");
      });
      const custom = root.querySelector("[data-custom-label]");
      if (custom instanceof HTMLElement) custom.hidden = Boolean(id);
    }
    function renderDrivers() {
      const list = root.querySelector("[data-driver-list]"), empty = root.querySelector("[data-driver-empty]");
      const axis = root.querySelector("[data-driver-axis]");
      if (!(list instanceof HTMLOListElement)) return;
      const unit = driverMode === "totalEnergy" ? "Wh" : "mL";
      const label = driverMode === "totalEnergy" ? "broader-system energy" : "total water";
      const ranked = computed.filter((row) => row.quantity > 0).sort((a,b) => b[driverMode] - a[driverMode]);
      const maximum = ranked.length ? Math.max(...ranked.map((row) => row[driverMode])) : 0;
      const increment = maximum > 100 ? 100 : maximum > 10 ? 10 : 1;
      const axisMax = maximum ? Math.ceil(maximum / increment) * increment : 100;
      list.replaceChildren();
      ranked.forEach((row) => {
        const item = document.createElement("li"); item.dataset.group = groupFor(row);
        const icon = document.createElement("span"); icon.className = "ydl-icon";
        icon.dataset.icon = iconNames[row.id]; icon.setAttribute("aria-hidden","true");
        const name = document.createElement("span"); name.textContent = row.shortLabel || shortLabels[row.id] || row.label;
        const track = document.createElement("span"); track.className = "ydl-track";
        const fill = document.createElement("span"); fill.style.width = `${100 * row[driverMode] / axisMax}%`; track.append(fill);
        const value = document.createElement("strong"); value.textContent = `${format(row[driverMode])} ${unit}`;
        item.append(icon,name,track,value); list.append(item);
      });
      if (empty instanceof HTMLElement) empty.hidden = ranked.length > 0;
      if (axis instanceof HTMLElement) {
        axis.innerHTML = `<span>0</span><span>${format(axisMax/4)}</span><span>${format(axisMax/2)}</span><span>${format(axisMax*.75)}</span><span>${format(axisMax)}</span>`;
        axis.hidden = ranked.length === 0;
      }
      list.setAttribute("aria-label", `Activities ranked by ${label}`);
      const total = ranked.reduce((sum,row) => sum + row[driverMode], 0);
      const totalLabel = root.querySelector("[data-driver-total-label]"), totalValue = root.querySelector("[data-driver-total]");
      const note = root.querySelector("[data-driver-note]");
      if (totalLabel) totalLabel.textContent = driverMode === "totalEnergy" ? "Total broader-system energy" : "Total water";
      if (totalValue) totalValue.innerHTML = metricHtml(total, unit);
      if (note) note.textContent = `Contributions for the amounts selected, ${label}.`;
    }
    function render() {
      computed = activities.map((activity) => {
        const input = root.querySelector(`[data-activity-input="${activity.id}"]`);
        const parsed = Number.parseFloat(input?.value || "0");
        const quantity = Number.isFinite(parsed) && parsed > 0
          ? (wholeRequests(activity) ? Math.round(parsed) : parsed)
          : 0;
        return {...activity, quantity, serverEnergy:quantity*activity.serverWhPerUnit,
          totalEnergy:quantity*totalRate(activity), directWater:quantity*activity.directWaterMlPerUnit,
          totalWater:quantity*activity.totalWaterMlPerUnit};
      });
      const totals = computed.reduce((sum,row) => ({serverEnergy:sum.serverEnergy+row.serverEnergy,
        totalEnergy:sum.totalEnergy+row.totalEnergy,directWater:sum.directWater+row.directWater,
        totalWater:sum.totalWater+row.totalWater}), {serverEnergy:0,totalEnergy:0,directWater:0,totalWater:0});
      Object.entries(totals).forEach(([key,value]) => {
        const node = root.querySelector(`[data-summary="${key}"]`);
        if (node) node.innerHTML = metricHtml(value, key.includes("Water") ? "mL" : "Wh");
      });
      const battery=root.querySelector("[data-summary='energyLaptop']"), cups=root.querySelector("[data-summary='waterCups']");
      if (battery) battery.textContent=format(totals.totalEnergy/50);
      if (cups) cups.textContent=cupFormatter.format(totals.totalWater/236.588);
      computed.forEach((row) => {
        const card=root.querySelector(`[data-activity="${row.id}"]`); card?.classList.toggle("is-inactive",row.quantity===0);
        const rate=root.querySelector(`[data-base-rate="${row.id}"]`); if(rate) rate.textContent=`${row.id === "coding-agent-requests-intensive" ? "~" : ""}${format(totalRate(row))} Wh`;
        const unit=root.querySelector(`[data-unit-label="${row.id}"]`); if(unit) unit.textContent=unitLabel(row,row.quantity);
        const down=root.querySelector(`[data-step-down="${row.id}"]`); if(down instanceof HTMLButtonElement) down.disabled=row.quantity<=0;
        const minutes=root.querySelector(`[data-minutes="${row.id}"]`);
        if(minutes instanceof HTMLElement){const show=row.unitLabel==="hours"&&row.quantity>0&&!Number.isInteger(row.quantity);
          minutes.hidden=!show;minutes.textContent=show?`${format(row.quantity*60)} minutes selected`:"";}
        const dialog=root.querySelector(`[data-detail-dialog="${row.id}"]`);
        if(dialog){const values={quantity:`${format(row.quantity)} ${unitLabel(row,row.quantity)}`,serverEnergy:`${format(row.serverEnergy)} Wh`,
          totalEnergy:`${format(row.totalEnergy)} Wh`,directWater:`${format(row.directWater)} mL`,totalWater:`${format(row.totalWater)} mL`};
          Object.entries(values).forEach(([key,value])=>{const node=dialog.querySelector(`[data-detail-value="${key}"]`);if(node)node.textContent=value;});}
      });
      root.querySelectorAll("[data-group-count]").forEach((node) => {
        const id=node.getAttribute("data-group-count"), total=computed.filter((row)=>groupFor(row)===id).length;
        const active=computed.filter((row)=>groupFor(row)===id&&row.quantity>0).length;node.textContent=`${active} active of ${total}`;
      });
      const live=root.querySelector("[data-live-summary]");
      if(live)live.textContent=`Current totals are ${format(totals.totalEnergy)} watt-hours broader-system energy and ${format(totals.totalWater)} milliliters total water.`;
      renderDrivers();
    }
    function applyPreset(id) {
      const preset=presets.find((item)=>item.id===id);if(!preset)return;
      inputs.forEach((input)=>{input.value=String(preset.values?.[input.dataset.activityInput]??0);});
      selects.forEach((select)=>{const activity=activityMap.get(select.dataset.deviceSelect);
        select.value=preset.deviceSelections?.[select.dataset.deviceSelect]??activity?.defaultDeviceId??activity?.deviceSelectableIds?.[0]??"";});
      setPresetState(id);render();
    }
    function markCustom(){setPresetState("");render();}
    function normalizeRequestInput(input, allowEmpty=false){
      const activity=activityMap.get(input.dataset.activityInput);
      if(!wholeRequests(activity))return;
      if(allowEmpty&&input.value==="")return;
      const parsed=Number.parseFloat(input.value||"0");
      input.value=String(Number.isFinite(parsed)?Math.max(0,Math.round(parsed)):0);
    }
    inputs.forEach((input)=>{
      input.addEventListener("input",()=>{
        normalizeRequestInput(input,true);
        markCustom();
      });
      input.addEventListener("change",()=>{
        normalizeRequestInput(input);
        markCustom();
      });
    });
    selects.forEach((select)=>select.addEventListener("change",markCustom));
    presetButtons.forEach((button)=>button.addEventListener("click",()=>applyPreset(button.dataset.preset)));
    root.querySelector("[data-clear-all]")?.addEventListener("click",()=>applyPreset("clear"));
    root.querySelectorAll("[data-step-up], [data-step-down]").forEach((button)=>button.addEventListener("click",()=>{
      const id=button.dataset.stepUp||button.dataset.stepDown,activity=activityMap.get(id);
      const input=root.querySelector(`[data-activity-input="${id}"]`);if(!(input instanceof HTMLInputElement)||!activity)return;
      const direction=button.hasAttribute("data-step-up")?1:-1;
      const current=wholeRequests(activity)?Math.round(Number(input.value)||0):(Number(input.value)||0);
      input.value=String(Math.max(0,Math.round((current+direction*activity.step)*100)/100));markCustom();
    }));
    root.querySelectorAll("[data-driver-mode]").forEach((button)=>button.addEventListener("click",()=>{
      driverMode=button.dataset.driverMode;root.querySelectorAll("[data-driver-mode]").forEach((candidate)=>{
        const active=candidate.dataset.driverMode===driverMode;candidate.classList.toggle("is-active",active);
        candidate.setAttribute("aria-pressed",active?"true":"false");});renderDrivers();
    }));
    root.querySelectorAll("[data-open-detail]").forEach((button)=>button.addEventListener("click",()=>{
      const dialog=root.querySelector(`[data-detail-dialog="${button.dataset.openDetail}"]`);
      if(dialog instanceof HTMLDialogElement)dialog.showModal();
    }));
    root.querySelectorAll("[data-detail-dialog]").forEach((dialog)=>{
      dialog.querySelector("[data-close-detail]")?.addEventListener("click",()=>dialog.close());
      dialog.addEventListener("click",(event)=>{if(event.target===dialog)dialog.close();});
    });
    applyPreset("gen-z-vibe-coder");
  })();
</script>
