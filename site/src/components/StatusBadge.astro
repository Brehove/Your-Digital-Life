---
interface Props {
  status: "verified" | "inferred" | "estimated" | "contested";
}

const { status } = Astro.props;

const labels = {
  verified: "Verified",
  inferred: "Inferred",
  estimated: "Estimated",
  contested: "Contested"
};
---

<span class:list={["status-badge", `status-badge--${status}`]}>{labels[status]}</span>

