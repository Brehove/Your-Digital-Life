---
import type { CollectionEntry } from "astro:content";

interface Props {
  update: CollectionEntry<"updates">;
}

const { update } = Astro.props;
const data = update.data;
---

<article class="card update-card">
  <div class="card__topline">
    <p class="eyebrow">Update</p>
    <span class="update-date">{data.date}</span>
  </div>

  <h3>{data.title}</h3>
  <p>{data.summary}</p>

  <ul class="compact-list">
    {data.changedItems.map((item) => <li>{item}</li>)}
  </ul>

  <p class="note">Reason: {data.reason}</p>
  <p class="muted">Public impact: {data.impactOnPublicCopy}</p>
</article>

