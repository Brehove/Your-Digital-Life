---
import InventoryTool from "../components/InventoryTool.astro";
import SiteMasthead from "../components/SiteMasthead.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getPageById } from "../lib/content";

const homePage = await getPageById("home");
const pageTitle = homePage?.data.title ?? "What Your Digital Life Uses";
const pageDescription = homePage?.data.description ?? "Estimate the energy and water behind a day of cloud-connected digital activity.";
const heroTitle = homePage?.data.heroTitle ?? pageTitle;
const heroSummary = homePage?.data.heroSummary ?? pageDescription;
const heroSupportingText = homePage?.data.heroSupportingText ?? "Start with a mix, then adjust it to yours.";
const heroParts = heroTitle.trim().match(/^(.*\s)(\S+)$/);
const heroLead = heroParts?.[1] ?? "";
const heroAccent = heroParts?.[2] ?? heroTitle;
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  pageClass="page-frame--landing"
  shellClass="site-shell--landing"
  bodyClass="body--landing"
  hideFooter={true}
  hideNav={true}
  hideHeader={true}
>
  <div class="landing-shell">
    <SiteMasthead />

    <div class="landing-main">
      <section class="landing-intro" aria-labelledby="landing-title">
        <h1 id="landing-title">{heroLead}<em>{heroAccent}</em></h1>
        <p class="landing-lead">{heroSummary}</p>
        <p>{heroSupportingText}</p>
      </section>

      <InventoryTool showEvidenceTable={false} />
    </div>

    <footer class="landing-footer">
      <span>Estimates, not a meter reading</span>
      <span>
        Inspiration and early blueprint:
        <a href="https://what-uses-more.com/" target="_blank" rel="noreferrer">What Uses More?</a>
        by Jon Ippolito.
      </span>
      <a href="/about-this-site/">Credits & license details</a>
    </footer>
  </div>
</BaseLayout>
