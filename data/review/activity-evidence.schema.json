{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "activity-evidence.schema.json",
  "title": "Your Digital Life activity evidence review overlay",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "overlayVersion",
    "datasetVersion",
    "reviewedOn",
    "status",
    "compatibility",
    "records"
  ],
  "properties": {
    "overlayVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "datasetVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "reviewedOn": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "const": "review-overlay"
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "calculatorInput",
        "websiteInput",
        "releaseArtifact"
      ],
      "properties": {
        "calculatorInput": {
          "const": false
        },
        "websiteInput": {
          "const": false
        },
        "releaseArtifact": {
          "const": false
        }
      }
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/reviewRecord"
      }
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "reviewRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "activityId",
        "formulaStatus",
        "provenanceSummary",
        "additionalSourceIds",
        "reviewFindings"
      ],
      "properties": {
        "activityId": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "formulaStatus": {
          "enum": [
            "source-value",
            "documented-derivation",
            "partial-derivation",
            "undocumented-internal-coefficient"
          ]
        },
        "provenanceSummary": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "additionalSourceIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        },
        "reviewFindings": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        }
      }
    }
  }
}
