{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "source-evidence.schema.json",
  "title": "Your Digital Life source evidence review overlay",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "overlayVersion",
    "datasetVersion",
    "reviewedOn",
    "status",
    "compatibility",
    "records"
  ],
  "properties": {
    "overlayVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "datasetVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "reviewedOn": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "const": "review-overlay"
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "calculatorInput",
        "websiteInput",
        "releaseArtifact"
      ],
      "properties": {
        "calculatorInput": {
          "const": false
        },
        "websiteInput": {
          "const": false
        },
        "releaseArtifact": {
          "const": false
        }
      }
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/reviewRecord"
      }
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "citation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "authors",
        "organization",
        "publishedDate",
        "url"
      ],
      "properties": {
        "title": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "authors": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        },
        "organization": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "publishedDate": {
          "oneOf": [
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "string",
              "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])$"
            }
          ]
        },
        "lastUpdatedDate": {
          "type": "string",
          "format": "date"
        },
        "venue": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "doi": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "reportNumber": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "url": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "locator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "locator",
        "relevance"
      ],
      "properties": {
        "locator": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "relevance": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "reviewRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceId",
        "citation",
        "evidenceType",
        "reviewStatus",
        "preciseLocators",
        "measurementBoundary",
        "workloadAndHardware",
        "geography",
        "derivation",
        "limitations"
      ],
      "properties": {
        "sourceId": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "citation": {
          "$ref": "#/$defs/citation"
        },
        "evidenceType": {
          "enum": [
            "direct-measurement",
            "modeled-estimate",
            "secondary-synthesis",
            "expert-analysis",
            "internal-method",
            "mixed-method"
          ]
        },
        "reviewStatus": {
          "enum": [
            "reviewed-with-limitations",
            "needs-primary-source",
            "needs-update",
            "illustrative-only",
            "internal-method"
          ]
        },
        "preciseLocators": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/locator"
          }
        },
        "measurementBoundary": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "workloadAndHardware": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "geography": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "derivation": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "limitations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        }
      }
    }
  }
}
